# ---------------------------------------------------------------
# Site Tsak Tsak — variables d’environnement
# Copier en .env.local pour le développement ; en production, les définir dans Coolify.
# ---------------------------------------------------------------

# Adresse publique du site (liens de retour Stripe et liens dans les courriels)
SITE_URL=https://tsaktsak.com

# Base PostgreSQL (dans Coolify : l’URL interne de la base PostgreSQL)
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/tsaktsak

# Admin (/admin) masqué (page introuvable) tant que ADMIN_ENABLED n’est pas true.
ADMIN_ENABLED=false
# Premier accès à l’admin : le compte est créé à la première connexion avec ces valeurs.
# Une fois connecté, vous pouvez retirer ADMIN_PASSWORD.
ADMIN_EMAIL=stella@tsaktsak.com
ADMIN_PASSWORD=

# Stripe (Tableau de bord Stripe → Développeurs → Clés API ; sk_test_… pour tester, sk_live_… en production)
STRIPE_SECRET_KEY=
# Webhook : https://tsaktsak.com/api/stripe/webhook (voir README)
STRIPE_WEBHOOK_SECRET=

# Épicerie « bientôt disponible » : se règle depuis l’admin (Paramètres). Mettre true ici force ce mode
# (remplace l’épicerie et le panier par un message et bloque les paiements), quoi qu’indique l’admin.
SHOP_COMING_SOON=false

# Google Maps (suggestions d’adresses de livraison) : APIs « Maps JavaScript API » et « Places API (New) »
GOOGLE_MAPS_API_KEY=

# Courriels (SMTP, par exemple Purelymail : smtp.purelymail.com, port 465)
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=resto@tsaktsak.com
SMTP_PASS=
MAIL_FROM="Tsak Tsak <resto@tsaktsak.com>"
# Destinataire des demandes du formulaire traiteur
CATERING_EMAIL_TO=resto@tsaktsak.com
# Destinataire des avis de commande (remplacé par le réglage de l’admin s’il est rempli)
ORDER_NOTIFICATION_EMAIL=resto@tsaktsak.com
